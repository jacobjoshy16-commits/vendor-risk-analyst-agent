# Runtime state. Regenerated by every run; not source.
# NOTE: data/findings.json is the finding lifecycle store. It is ignored here
# because this repo is a demo. In a real deployment you would either commit it
# (so accepted_risk decisions are reviewable and survive a machine rebuild) or
# back it with a database. Losing it loses every human lifecycle decision.
data/
out/
pending_review/

# Onboarding artifact cache (fetched copies of vendor trust-center pages).
artifacts/

# Registers a human writes with `vra connect`. A real vendor portfolio names
# your suppliers and your tenants — it does not belong in this repo. The demo
# registers ship in sandbox/registers/ instead.
vendors/*.yaml

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Last-resort credential file if the OS has no keychain. Never commit.
keyring.json
